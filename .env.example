ANTHROPIC_API_KEY=sk-ant-...

# The read-only role created by sql/readonly_role.sql.
# Current versions of Pagila load the data into a database called "pagila".
# The assignment notes describe an older setup that loads it into "postgres".
# If that is yours, end the URL with /postgres.
DATABASE_URL=postgresql://analyst:analyst@localhost:5432/pagila

# Optional, shown with their defaults.
# ANTHROPIC_MODEL=claude-opus-5-5
# REASONING_EFFORT=high
# GLOSSARY_PATH=glossary.example.md
# MAX_STEPS=10
# MAX_ROWS=100
# MAX_RESULT_CHARS=40000
# STATEMENT_TIMEOUT_MS=15000
# REQUEST_TIMEOUT_SECONDS=120
# AUDIT_LOG_PATH=audit.jsonl
