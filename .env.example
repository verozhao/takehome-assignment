ANTHROPIC_API_KEY=sk-ant-...

# The read-only role created by sql/readonly_role.sql.
# The assignment's Pagila setup loads the data into the default "postgres" database.
# Newer versions of the Pagila docker-compose file load it into "pagila" instead.
# If that is your setup, end the URL with /pagila.
DATABASE_URL=postgresql://analyst:analyst@localhost:5432/postgres

# Optional, shown with their defaults.
# ANTHROPIC_MODEL=claude-opus-5-5
# REASONING_EFFORT=high
# MAX_STEPS=10
# MAX_ROWS=100
# MAX_RESULT_CHARS=40000
# STATEMENT_TIMEOUT_MS=15000
